---
import { type ClubLocationType } from "../content.types";

type Props = {
  location: ClubLocationType;
};
const { location } = Astro.props;
const hasAddress = location.address;
---

<Fragment>
  <Fragment>{hasAddress ? "address: " : ""}</Fragment>
  <Fragment>
    {
      hasAddress && location.addressLink && (
        <a href={location.addressLink}>{location.address}</a>
      )
    }
  </Fragment>
  <Fragment>{!location.addressLink ? location.address : ""}</Fragment>
  {hasAddress && <br />}
</Fragment>
