---
import _ from "lodash";
import { markdownify, slugify } from "@/lib/utils/textConverter";
import { type ClubLocationType } from "../content.types";
import { type CollectionEntry } from "astro:content";
import Tile from "@/components/Tile.astro";
import ClubAddress from "@/components/ClubAddress.astro";

type Props = {
  post: CollectionEntry<"clubs">;
  displayReadMore?: boolean;
  styling: string;
  headerStyling?: string;
  heroTextStyling?: string;
  topBorderStyling?: string;
};

const {
  post,
  styling,
  headerStyling = "",
  topBorderStyling = "tile-default-top-border-style", // TODO: rename to topBorderClasses
  heroTextStyling = "",
} = Astro.props;

const mediaClasses = (() => {
  const tileBodyClass = "";
  const tileBodyMediaClass = "";
  const tileClass = "tile-with-body-media";

  return {
    tile: tileClass,
    topBorderStyling: topBorderStyling,
    defaultTopBoardeBehaviour: true,
    headerMedia: "",
    body: tileBodyClass,
    bodyMedia: tileBodyMediaClass,
  };
})();

const hasTextBody = (post.body || "") != "";
const logoBackgroundColor = post.data?.logoBackgroundColor ? `bg-${post.data?.logoBackgroundColor}` : "";
const logoBorder = post.data?.logoBackgroundColor ? `border-2 border-${post.data?.logoBackgroundColor}` : "";
---

<Tile
  id={slugify(post.data.name) || post.id}
  headerStyling={headerStyling}
  bodyStyling={`${heroTextStyling} ${mediaClasses.body}`}
  styling={`${styling} ${mediaClasses.tile}`}
>
  <Fragment slot="title">
    <h3 class={`${headerStyling} text-gold w-full pt-2 text-center`}>
      {post.data.name}
    </h3>
  </Fragment>
  <Fragment slot="body">
    { post.data.logo && (<div class={`h-auto w-full flex flex-col items-center justify-center ${logoBorder} ${logoBackgroundColor}`}>
      <picture class="tile-image h-auto">
        <img
          src={post.data.logo}
          alt="logo"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>)
    }
    <span
      data-testid="tile-body-text"
      class={`flex flex-col items-center px-4 pb-1 max-w-[100%] tile-body-text a-tag-underline text-center text-lg`}
      >
      {
        Object.entries(post.data.info).map(([name, value]) => (
          <div>{_.startCase(name)}: {value}</div>
        ))
      }
      {
        Object.entries(post.data.locations).map(([attrName, value]) => (
        <Fragment>
          <Fragment>{attrName}: {value.name}</Fragment><br />
          <ClubAddress location={value} />
        </Fragment>
        ))
      }
      {post.data?.league && (<Fragment>league: {post.data?.league}</Fragement>)}
      {
        Object.entries(post.data.links).map(([name, url]) => (
          <span>
            <a href={url} class="text-gold">
              {_.startCase(name)}
            </a>
          </span>
        ))
      }
      {
        hasTextBody && (
          <hr data-testid="divider" class="border-inset border-b-1 border-divider w-full" />
          <div
            class={`${heroTextStyling} tile-body-hero-text a-tag-underline text-center text-lg wrap-break-word`}
          >
            <Fragment set:html={markdownify(post.body!)} />
          </div>
        )
      }
    </span>
  </Fragment>
</Tile>
<style>
  @import "@/components/Post.css";
  @reference "@/styles/tailwind.css";
  /* TODO: safelist */
  .bg-black {
    background-color: black;
  }
  .tile-body-hero-text {
    max-width: 100%;
  }
  .tile-body-hero-text > :global(p) {
    max-width: 100%;
    white-space-collapse: preserve-breaks;
    white-space: pre-line;
  }
</style>
